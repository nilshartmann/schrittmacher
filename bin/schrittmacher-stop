#!/bin/sh
# Beendet die Web-App und den Server von Schrittmacher, egal ob ihn `schrittmacher-start` oder
# `pnpm dev…` gestartet hat. Beendet wird nur ein Vite-Prozess auf dem Port, damit nichts Fremdes
# getroffen wird. Safari selbst bleibt offen, weil die Web-App eine eigene App ist.
#
#   SCHRITTMACHER_URL  der Server, sonst http://127.0.0.1:5310; daraus stammt der Port
#   SCHRITTMACHER_APP  die Web-App, sonst Schrittmacher; leer, um sie offen zu lassen
set -eu

url="${SCHRITTMACHER_URL:-http://127.0.0.1:5310}"
app="${SCHRITTMACHER_APP-Schrittmacher}"
port="$(printf '%s\n' "$url" | sed -E 's#^[a-z]+://[^/:]+:([0-9]+).*$#\1#')"

if [ -n "$app" ]; then
  osascript -e "if application \"$app\" is running then tell application \"$app\" to quit"
fi

pids="$(lsof -ti "tcp:$port" -sTCP:LISTEN || true)"
if [ -z "$pids" ]; then
  echo "schrittmacher: Auf Port $port läuft kein Server."
  exit 0
fi

for pid in $pids; do
  if ps -o command= -p "$pid" | grep -q vite; then
    # Mit dem Vite-Prozess endet auch das pnpm darüber.
    kill "$pid"
  else
    echo "schrittmacher: Auf Port $port läuft kein Vite, sondern: $(ps -o command= -p "$pid")" >&2
    exit 1
  fi
done

waited=0
while lsof -ti "tcp:$port" -sTCP:LISTEN >/dev/null; do
  if [ "$waited" -ge 20 ]; then
    echo "schrittmacher: Der Server auf Port $port läuft nach 10 Sekunden noch." >&2
    exit 1
  fi
  sleep 0.5
  waited=$((waited + 1))
done
echo "schrittmacher: Server auf Port $port beendet."
