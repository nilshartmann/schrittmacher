#!/bin/sh
# Öffnet einen Ordner als neuen Tab in Schrittmacher, wie `fork <pfad>` in Fork. Ohne Pfad gilt
# das aktuelle Verzeichnis. Eine Markdown-Datei zeigt Schrittmacher stattdessen gerendert an. Der
# Server muss laufen; danach kommt die Web-App nach vorn.
#
#   schrittmacher [pfad]          Ordner als Tab, Markdown-Datei als Ansicht
#   schrittmacher edit            Editor mit dem zuletzt gezeigten Stand
#   schrittmacher edit <datei>    Datei im Editor, auch eine, die es noch nicht gibt (docs/editor.md)
#   schrittmacher edit <ordner>   Ordner als Workspace im Editor
#   schrittmacher edit --neu      neuer Entwurf im Workspace „Entwürfe“
#
#   SCHRITTMACHER_URL  der Server, sonst http://127.0.0.1:5310
#   SCHRITTMACHER_APP  die Web-App, sonst Schrittmacher; leer, um sie nicht zu öffnen
set -eu

url="${SCHRITTMACHER_URL:-http://127.0.0.1:5310}"
app="${SCHRITTMACHER_APP-Schrittmacher}"

# Der absolute Pfad einer Datei, ohne symbolische Links im Ordner.
absolute_file() {
  echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
}

query=""
# Was sich öffnen soll, für die Fehlermeldung.
label=""
case "${1:-}" in
  edit)
    target="${2:-}"
    if [ -z "$target" ]; then
      path=""
      label="Der letzte Stand des Editors"
    elif [ "$target" = "--neu" ]; then
      path=""
      query="?neu"
      label="Der Entwurf"
    elif [ -d "$target" ]; then
      path="$(cd "$target" && pwd -P)"
    elif [ -d "$(dirname "$target")" ]; then
      path="$(absolute_file "$target")"
    else
      echo "schrittmacher: Den Ordner '$(dirname "$target")' gibt es nicht." >&2
      exit 1
    fi
    endpoint=edit
    ;;
  *)
    target="${1:-.}"
    if [ -f "$target" ]; then
      path="$(absolute_file "$target")"
      endpoint=markdown
    else
      path="$(cd "$target" && pwd -P)"
      endpoint=tab
    fi
    ;;
esac

# Bei einem Fehler zeigt curl nur die Meldung des Servers; ist er nicht erreichbar, fehlt sie.
if ! message="$(curl -s --fail-with-body -X POST --data-binary "$path" "$url/api/$endpoint$query")"; then
  echo "schrittmacher: ${label:-"'$path'"} ließ sich nicht öffnen. ${message:-Läuft der Server unter $url?}" >&2
  exit 1
fi
if [ -n "$app" ]; then
  open -a "$app"
fi
